:root {
  font: 15px/1.6 system-ui,-apple-system,"Segoe UI",sans-serif;
  color: #e8eef6;
  background: #0d121a;
  color-scheme: dark;
  --line: #283344;
  --muted: #96a7be;
  --codex: #6bc6aa;
  --claude: #dba07b;
  --google: #8baeff;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
}

main {
  max-width: 1280px;
  margin: auto;
  padding: 38px 36px;
}

h1, h2, h3, p {
  margin: 0;
}

h1 {
  font-size: 29px;
  letter-spacing: -1px;
  margin-top: 9px;
}

h2 {
  font-size: 23px;
  letter-spacing: -.5px;
}

h3 {
  font-size: 15px;
  font-weight: 600;
}

p {
  color: var(--muted);
}

header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24px;
}

header p {
  margin-top: 8px;
}

.eyebrow {
  font-size: 10px;
  font-weight: 650;
  letter-spacing: 1.6px;
  color: var(--muted);
}

.signal {
  display: inline-block;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--codex);
  margin-right: 7px;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 24px;
}

a {
  color: #b7c8de;
  text-decoration: none;
}

a:hover {
  text-decoration: underline;
}

button, select {
  border: 1px solid #3a4b64;
  background: #1b2a40;
  color: inherit;
  border-radius: 7px;
  padding: 9px 14px;
  font: inherit;
  font-size: 12px;
}

button {
  cursor: pointer;
}

button:hover {
  background: #263b57;
}

button:disabled {
  opacity: .5;
  cursor: wait;
}

button:focus-visible, a:focus-visible, select:focus-visible, summary:focus-visible, .chart-column:focus-visible {
  outline: 2px solid #92bfff;
  outline-offset: 4px;
}

#health {
  color: #81c8ab;
  font-size: 12px;
  margin-top: 20px;
}

.error {
  color: #f6aa92!important;
}

.muted {
  color: var(--muted);
  font-size: 12px;
}

.overview {
  display: grid;
  grid-template-columns: repeat(4,minmax(0,1fr));
  border: 1px solid var(--line);
  border-radius: 11px;
  background: #131c28;
  margin: 22px 0 38px;
  padding: 23px 0;
}

.overview-item {
  padding: 0 26px;
  border-right: 1px solid var(--line);
}

.overview-item:last-child {
  border: 0;
}

.overview-item span {
  display: block;
  color: var(--muted);
  font-size: 12px;
}

.overview-item strong {
  display: block;
  font-size: 24px;
  font-weight: 550;
  margin-top: 8px;
}

#live {
  font-size: 20px;
}

.section-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18px;
  margin-bottom: 9px;
}

.section-heading .eyebrow {
  margin-bottom: 3px;
}

.section-note {
  font-size: 12px;
  margin-bottom: 20px;
  max-width: 850px;
}

.window-label {
  display: flex;
  align-items: center;
  gap: 10px;
  color: var(--muted);
  font-size: 12px;
}

.provider-grid {
  display: grid;
  grid-template-columns: repeat(3,minmax(0,1fr));
  gap: 16px;
}

.provider-card {
  background: #17212e;
  border: 1px solid var(--line);
  border-radius: 11px;
  padding: 21px 23px;
  border-top: 2px solid var(--accent);
}

.provider-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
}

.provider-brand {
  font-size: 17px;
  font-weight: 600;
  color: var(--accent);
}

.badge {
  font-size: 10px;
  border-radius: 20px;
  padding: 3px 8px;
  background: #243246;
  color: #c1ccdb;
}

.badge.available {
  background: #153c33;
  color: #99dfc7;
}

.badge.unavailable {
  background: #402c27;
  color: #edb69c;
}

.token-caption {
  font-size: 11px;
  color: var(--muted);
  margin-top: 23px;
}

.token-value {
  font-size: 31px;
  letter-spacing: -.7px;
  font-weight: 600;
  line-height: 1.3;
  margin: 5px 0 18px;
}

.token-value small {
  font-size: 12px;
  color: var(--muted);
  font-weight: 400;
  letter-spacing: 0;
  margin-left: 5px;
}

.token-breakdown {
  display: grid;
  grid-template-columns: repeat(3,1fr);
  gap: 8px;
  margin: 0;
  padding-bottom: 17px;
  border-bottom: 1px solid var(--line);
}

.token-breakdown dt {
  font-size: 10px;
  color: var(--muted);
}

.token-breakdown dd {
  font-size: 13px;
  margin: 4px 0 0;
  font-variant-numeric: tabular-nums;
}

.quota-line {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  font-size: 11px;
  color: var(--muted);
  margin-top: 14px;
}

.quota-line strong {
  font-weight: 500;
  color: #c3cedd;
}

.provider-note {
  font-size: 10px;
  color: var(--muted);
  margin-top: 8px;
  overflow-wrap: anywhere;
}

.activity-panel {
  margin-top: 18px;
  background: #131c28;
  border: 1px solid var(--line);
  border-radius: 11px;
  padding: 23px 26px;
}

.chart-heading {
  display: flex;
  justify-content: space-between;
  gap: 16px;
}

.chart-heading p {
  margin-top: 5px;
}

.chart-total {
  text-align: right;
}

.chart-total strong {
  font-size: 25px;
  font-weight: 600;
  display: block;
  line-height: 1.2;
}

.chart-total span {
  font-size: 10px;
  color: var(--muted);
}

.chart-scroll {
  overflow-x: auto;
}

.chart {
  display: grid;
  grid-template-columns: repeat(var(--days,7),minmax(20px,1fr));
  align-items: end;
  gap: 10px;
  height: 180px;
  min-width: 400px;
  margin-top: 10px;
}

.chart.empty {
  display: flex;
  justify-content: center;
  align-items: center;
  min-width: 0;
  height: 150px;
  color: var(--muted);
  font-size: 13px;
}

.chart-column {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  height: 170px;
  position: relative;
}

.bar-stack {
  width: min(36px,70%);
  display: flex;
  flex-direction: column-reverse;
  border-radius: 4px 4px 0 0;
  overflow: hidden;
  min-height: 1px;
  background: #233042;
}

.bar-part {
  width: 100%;
}

.codex {
  background: var(--codex);
}

.claude {
  background: var(--claude);
}

.google {
  background: var(--google);
}

.day-label {
  font-size: 10px;
  color: var(--muted);
  margin-top: 10px;
  height: 16px;
}

.chart-footer {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  border-top: 1px solid var(--line);
  padding-top: 15px;
  margin-top: 10px;
  color: var(--muted);
  font-size: 10px;
}

.legend {
  display: flex;
  gap: 18px;
}

.legend span {
  display: flex;
  align-items: center;
  gap: 6px;
}

.legend i {
  width: 7px;
  height: 7px;
  border-radius: 2px;
  display: inline-block;
}

#usage-source {
  margin: 12px 0 36px;
}

#queue {
  scroll-margin-top: 20px;
}

.table-wrap {
  overflow-x: auto;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: #131c28;
  margin-top: 18px;
}

table {
  border-collapse: collapse;
  width: 100%;
  font-size: 12px;
}

td, th {
  text-align: left;
  padding: 16px;
  border-bottom: 1px solid var(--line);
  white-space: nowrap;
}

th {
  color: var(--muted);
  font-size: 10px;
  font-weight: 500;
  background: #17212e;
}

tr:last-child td {
  border-bottom: 0;
}

td:first-child {
  white-space: normal;
  min-width: 180px;
}

td button {
  padding: 5px 13px;
}

details {
  margin-top: 18px;
  border: 1px solid var(--line);
  border-radius: 9px;
  background: #131c28;
}

summary {
  padding: 15px 18px;
  cursor: pointer;
  color: #becce0;
  font-size: 12px;
}

#detail {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  font-size: 11px;
  max-height: 400px;
  overflow: auto;
  margin: 0;
  padding: 0 20px 20px;
}

footer {
  border-top: 1px solid var(--line);
  padding-top: 22px;
  margin-top: 32px;
  font-size: 10px;
  color: var(--muted);
}

@media(max-width:900px) {
  main {
    padding: 28px 22px;
  }
  .header-actions {
    gap: 14px;
  }
  .provider-card {
    padding: 17px;
  }
  .token-breakdown {
    grid-template-columns: 1fr 1fr;
  }
  .token-breakdown div:last-child {
    grid-column: 1/-1;
  }
  .overview-item {
    padding: 0 16px;
  }
  .token-value {
    font-size: 26px;
  }
}

@media(max-width:650px) {
  main {
    padding: 23px 16px;
  }
  header {
    align-items: flex-start;
    flex-direction: column;
    gap: 18px;
  }
  h1 {
    font-size: 25px;
  }
  .header-actions {
    width: 100%;
    justify-content: space-between;
  }
  .overview {
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    padding: 18px 0;
    margin-bottom: 28px;
  }
  .overview-item:nth-child(2) {
    border: 0;
  }
  .overview-item strong {
    font-size: 21px;
  }
  .provider-grid {
    grid-template-columns: 1fr;
  }
  .token-breakdown {
    grid-template-columns: repeat(3,1fr);
  }
  .token-breakdown div:last-child {
    grid-column: auto;
  }
  .token-caption {
    margin-top: 17px;
  }
  .token-value {
    margin-bottom: 12px;
  }
  .activity-panel {
    padding: 18px;
  }
  .section-heading {
    align-items: flex-start;
  }
  .section-heading>.muted {
    max-width: 140px;
    text-align: right;
  }
  .window-label {
    flex-direction: column;
    align-items: flex-end;
    gap: 3px;
  }
  .chart-footer {
    flex-direction: column;
  }
  .chart-total strong {
    font-size: 21px;
  }
  .chart-heading p {
    max-width: 180px;
  }
}

.service-panel {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px 24px;
  border: 1px solid var(--line);
  border-left: 3px solid #dba07b;
  border-radius: 9px;
  background: #131c28;
  padding: 14px 20px;
  margin-top: 16px;
}

.service-panel strong {
  display: block;
  font-size: 16px;
}

.service-panel p {
  flex-basis: 100%;
}

.service-running {
  border-left-color: var(--codex);
}

.service-running strong {
  color: var(--codex);
}

.service-stopped strong {
  color: #edb69c;
}

.queue-filters {
  display: flex;
  align-items: end;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 18px;
}

.queue-filters label {
  display: flex;
  flex-direction: column;
  gap: 5px;
  font-size: 12px;
  color: var(--muted);
}

.queue-filters input {
  background: #1b2a40;
  color: inherit;
  border: 1px solid #3a4b64;
  border-radius: 7px;
  font: inherit;
  padding: 9px 12px;
  min-width: 190px;
}

.queue-filters select {
  max-width: 100%;
}

.task-reason {
  display: block;
  color: var(--muted);
  font-size: 11px;
  max-width: 230px;
  white-space: normal;
  margin-top: 4px;
}

.queue-filters input:focus-visible {
  outline: 2px solid #92bfff;
  outline-offset: 4px;
}

@media(max-width:650px) {
  .service-panel {
    padding: 13px 16px;
    gap: 7px;
  }
  .service-panel>div:first-child {
    flex-basis: 100%;
  }
  .queue-filters label {
    flex: 1;
    min-width: 0;
  }
  .queue-filters input {
    min-width: 0;
    width: 100%;
  }
  .queue-filters select {
    width: 100%;
    min-width: 0;
  }
  .queue-filters>span {
    flex-basis: 100%;
  }
}

.quota-track {
  height: 6px;
  border-radius: 3px;
  background: #233042;
  margin-top: 7px;
  overflow: hidden;
}

.quota-fill {
  height: 100%;
  background: var(--accent);
  transition: width .4s;
}

.quota-fill.mid {
  background: #e6b45a;
}

.quota-fill.low {
  background: #e2735a;
}

.quota-meter {
  margin-top: 6px;
}

.quota-group {
  font-size: 12px;
  font-weight: 600;
  color: #c3cedd;
  margin-top: 16px;
}

#board {
  margin: 0 0 38px;
}

.running-now {
  background: #131c28;
  border: 1px solid var(--line);
  border-radius: 11px;
  padding: 16px 20px;
  margin-bottom: 16px;
}

.running-now h3 {
  font-size: 14px;
  margin-bottom: 10px;
}

.run-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 6px 16px;
  border-left: 3px solid var(--accent);
  padding: 7px 12px;
  margin-top: 8px;
  background: #17212e;
  border-radius: 6px;
  font-size: 12px;
}

.run-ai {
  color: var(--accent);
  min-width: 64px;
}

.run-model {
  color: #c3cedd;
}

.run-task {
  flex: 1 1 220px;
  color: #dbe3ee;
  overflow-wrap: anywhere;
}

.board {
  display: grid;
  grid-template-columns: repeat(auto-fit,minmax(210px,1fr));
  gap: 12px;
  align-items: start;
}

.board-column {
  background: #131c28;
  border: 1px solid var(--line);
  border-radius: 11px;
  padding: 12px;
}

.board-column h3 {
  font-size: 13px;
  margin-bottom: 10px;
  color: #c3cedd;
}

.board-doing {
  border-top: 2px solid #e6b45a;
}

.board-review {
  border-top: 2px solid #8baeff;
}

.board-approve {
  border-top: 2px solid #6bc6aa;
}

.board-done {
  border-top: 2px solid #3f8f73;
}

.board-problem {
  border-top: 2px solid #e2735a;
}

.board-todo {
  border-top: 2px solid #96a7be;
}

.board-card {
  display: flex;
  flex-direction: column;
  gap: 5px;
  background: #17212e;
  border: 1px solid var(--line);
  border-radius: 8px;
  padding: 10px 11px;
  margin-bottom: 8px;
  font-size: 12px;
}

.board-card strong {
  font-size: 12px;
  overflow-wrap: anywhere;
}

.board-step {
  color: #e6b45a;
  font-size: 11px;
}

.board-ai {
  color: #a9bad0;
  overflow-wrap: anywhere;
}

.board-card button {
  align-self: flex-start;
  padding: 4px 10px;
  font-size: 11px;
}

.tabs {
  display: flex;
  gap: 6px;
  border-bottom: 1px solid var(--line);
  margin: 8px 0 24px;
}

.tab {
  background: transparent;
  border: 1px solid transparent;
  border-bottom: 0;
  border-radius: 9px 9px 0 0;
  padding: 12px 26px;
  font-size: 14px;
  color: var(--muted);
}

.tab:hover {
  background: #17212e;
  color: #dbe3ee;
}

.tab-active {
  background: #17212e;
  color: #fff;
  border-color: var(--line);
  box-shadow: inset 0 -2px 0 #6bc6aa;
}

.status-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin: 0 0 26px;
}

.chip {
  padding: 6px 13px;
  border-radius: 999px;
  background: #17212e;
  border: 1px solid var(--line);
  font-size: 12px;
  color: #c3cedd;
}

.chip-doing {
  border-color: #e6b45a;
}

.chip-review {
  border-color: #8baeff;
}

.chip-approve {
  border-color: #6bc6aa;
}

.chip-done {
  border-color: #3f8f73;
}

.chip-problem {
  border-color: #e2735a;
}

.drawer {
  position: fixed;
  top: 0;
  right: 0;
  height: 100vh;
  width: min(780px,100vw);
  background: #0f1722;
  border-left: 1px solid var(--line);
  z-index: 20;
  overflow-y: auto;
  padding: 0 26px 48px;
  box-shadow: -12px 0 32px rgba(0,0,0,.5);
}

.drawer[hidden], .drawer-backdrop[hidden] {
  display: none;
}

.drawer-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(5,9,15,.6);
  z-index: 19;
}

.drawer-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: sticky;
  top: 0;
  background: #0f1722;
  padding: 16px 0 12px;
  z-index: 2;
  border-bottom: 1px solid var(--line);
}

.drawer-bar h2 {
  font-size: 17px;
}

.task-view {
  padding-top: 6px;
}

.view-head {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px 14px;
  padding: 14px 0 6px;
}

.view-title {
  font-size: 19px;
  flex: 1 1 100%;
}

.status-badge {
  padding: 5px 13px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 600;
  background: #243246;
  color: #dbe3ee;
}

.board-doing-badge {
  background: #4a3a14;
  color: #f1cd85;
}

.board-review-badge {
  background: #1d2b4d;
  color: #a9c3ff;
}

.board-approve-badge {
  background: #153c33;
  color: #99dfc7;
}

.board-done-badge {
  background: #13362b;
  color: #7fd1b0;
}

.board-problem-badge {
  background: #402c27;
  color: #f4b09a;
}

.board-todo-badge {
  background: #243246;
  color: #c1ccdb;
}

.view-alert {
  color: #f6aa92;
  background: #2a1b17;
  border: 1px solid #5a342b;
  padding: 10px 13px;
  border-radius: 8px;
  font-size: 12px;
  margin: 8px 0;
}

.view-section {
  border-top: 1px solid var(--line);
  padding: 16px 0;
}

.view-section h3 {
  font-size: 14px;
  margin-bottom: 10px;
}

.view-section h4 {
  font-size: 12px;
  color: var(--muted);
  font-weight: 500;
  margin: 12px 0 4px;
}

.kv {
  display: grid;
  grid-template-columns: 150px minmax(0,1fr);
  gap: 7px 14px;
  margin: 0;
  font-size: 12px;
}

.kv dt {
  color: var(--muted);
}

.kv dd {
  margin: 0;
  overflow-wrap: anywhere;
}

.view-pre {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  background: #131c28;
  border: 1px solid var(--line);
  border-radius: 8px;
  padding: 12px;
  font-size: 12px;
  max-height: 260px;
  overflow: auto;
  margin: 0;
}

.view-list {
  margin: 4px 0 8px;
  padding-left: 20px;
  font-size: 12px;
  color: #c3cedd;
}

.view-table td, .view-table th {
  padding: 8px 10px;
  white-space: normal;
  overflow-wrap: anywhere;
  font-size: 11px;
  vertical-align: top;
}

.view-section .table-wrap {
  margin-top: 0;
}

#detail-panel {
  margin-top: 22px;
}

@media (max-width:640px) {
  .tab {
    padding: 11px 14px;
    flex: 1;
  }
  .kv {
    grid-template-columns: 110px minmax(0,1fr);
  }
  .drawer {
    padding: 0 14px 40px;
  }
}

.live-panel {
  background: #131c28;
  border: 1px solid var(--line);
  border-left: 3px solid #6bc6aa;
  border-radius: 10px;
  padding: 14px 16px;
  margin: 12px 0 4px;
}

.live-head {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 6px 14px;
}

.live-head h3 {
  font-size: 14px;
  margin: 0;
}

.live-stamp {
  font-size: 11px;
  color: #6bc6aa;
  flex: 1;
}

.live-pause {
  font-size: 11px;
  color: var(--muted);
  display: flex;
  align-items: center;
  gap: 6px;
}

.live-now {
  font-size: 15px;
  line-height: 1.5;
  margin: 10px 0 12px;
  color: #fff;
}

.live-session {
  font-size: 11px;
  color: #a9bad0;
  margin: 8px 0;
  overflow-wrap: anywhere;
}

.stepper {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  list-style: none;
  padding: 0;
  margin: 0 0 6px;
}

.step {
  padding: 5px 10px;
  border-radius: 999px;
  font-size: 11px;
  background: #17212e;
  border: 1px solid var(--line);
  color: var(--muted);
}

.step-done {
  background: #13362b;
  border-color: #2c6b55;
  color: #9fdcc2;
}

.step-current {
  background: #4a3a14;
  border-color: #e6b45a;
  color: #f6d99a;
  font-weight: 600;
  box-shadow: 0 0 0 2px rgba(230,180,90,.18);
}

.step-stalled {
  background: #402c27;
  border-color: #e2735a;
  color: #f4b09a;
  font-weight: 600;
}

.live-logs h4 {
  font-size: 12px;
  color: var(--muted);
  font-weight: 500;
  margin: 14px 0 6px;
}

.log-file {
  margin-top: 6px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: #0c131c;
}

.log-file summary {
  font-size: 11px;
  padding: 8px 12px;
  color: #a9bad0;
}

.log-tail {
  margin: 0;
  padding: 10px 12px;
  max-height: 240px;
  overflow: auto;
  font-size: 11px;
  line-height: 1.5;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  color: #d3dcea;
  border-top: 1px solid var(--line);
}

/* Status icons: CSS-only so the text content of badges, steps and cells stays unchanged. */
[data-status]::before {
  display: inline-block;
  margin-right: 6px;
  font-style: normal;
  line-height: 1;
}

[data-status="queued"]::before {
  content: "\23F3";
}

[data-status="retry_wait"]::before {
  content: "\1F501";
}

[data-status="assigned"]::before {
  content: "\1F9F0";
}

[data-status="running"]::before {
  content: "\2699\FE0F";
}

[data-status="implementation_done"]::before {
  content: "\1F4DD";
}

[data-status="gates"]::before {
  content: "\1F9EA";
}

[data-status="waiting_for_independent_review"]::before {
  content: "\1F440";
}

[data-status="review"]::before {
  content: "\1F50D";
}

[data-status="ready_for_human_approval"]::before {
  content: "\1F64B";
}

[data-status="approved"]::before {
  content: "\2705";
}

[data-status="blocked"]::before {
  content: "\26D4";
}

[data-status="failed"]::before {
  content: "\274C";
}

[data-status="cancelled"]::before {
  content: "\1F6AB";
}

.step-done::before {
  content: "\2713"!important;
  color: #7fd1b0;
}

.step-todo {
  opacity: .65;
}

.step-stalled::before {
  content: "\26A0\FE0F"!important;
}

.run-row[data-status]::before, .board-card[data-status]::before, .live-panel[data-status]::before {
  content: none;
}

@keyframes cc-spin {
  to {
    transform: rotate(360deg);
  }
}

@keyframes cc-pulse {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: .35;
  }
}

@keyframes cc-glow {
  0%, 100% {
    box-shadow: 0 0 0 0 rgba(107,198,170,.0);
  }
  50% {
    box-shadow: 0 0 0 4px rgba(107,198,170,.28);
  }
}

@keyframes cc-shake {
  0%, 100% {
    transform: translateX(0);
  }
  25% {
    transform: translateX(-2px);
  }
  75% {
    transform: translateX(2px);
  }
}

[data-status="running"]::before, [data-status="gates"]::before, [data-status="review"]::before {
  animation: cc-spin 2s linear infinite;
}

[data-status="queued"]::before, [data-status="retry_wait"]::before, [data-status="assigned"]::before, [data-status="waiting_for_independent_review"]::before, [data-status="implementation_done"]::before {
  animation: cc-pulse 1.6s ease-in-out infinite;
}

.step-current::before {
  animation-duration: 1.6s;
}

.step-done::before, .step-stalled::before {
  animation: none!important;
}

.board-card[data-status="running"], .board-card[data-status="gates"], .board-card[data-status="review"], .board-card[data-status="assigned"], .run-row {
  border-left: 3px solid #e6b45a;
  animation: cc-pulse 2.4s ease-in-out infinite;
}

.board-card[data-status="ready_for_human_approval"] {
  animation: cc-glow 1.8s ease-in-out infinite;
  border-color: #6bc6aa;
}

.board-card[data-status="blocked"], .board-card[data-status="failed"] {
  border-color: #e2735a;
}

.board-card[data-status="failed"] .board-step::before {
  animation: cc-shake .5s 2;
}

.status-tag {
  display: inline-flex;
  align-items: center;
}

@media (prefers-reduced-motion:reduce) {
  [data-status]::before, .board-card, .run-row {
    animation: none!important;
  }
}

/* ---- Icons and motion for every section (CSS-only; DOM text is untouched) ---- */
@keyframes cc-fade-up {
  from {
    opacity: 0;
    transform: translateY(8px);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

@keyframes cc-slide-in {
  from {
    transform: translateX(40px);
    opacity: 0;
  }
  to {
    transform: none;
    opacity: 1;
  }
}

@keyframes cc-ping {
  0% {
    box-shadow: 0 0 0 0 rgba(107,198,170,.6);
  }
  100% {
    box-shadow: 0 0 0 9px rgba(107,198,170,0);
  }
}

@keyframes cc-shimmer {
  0% {
    background-position: -200% 0;
  }
  100% {
    background-position: 200% 0;
  }
}

.eyebrow::before, h2::before, h3::before, .overview-item span::before, .tab::before, .chip::before, #refresh::before, .drawer-bar h2::before, .live-head h3::before, .token-caption::before, summary::before, .service-panel .muted::before {
  display: inline-block;
  margin-right: 7px;
  font-style: normal;
  font-weight: 400;
  line-height: 1;
}

.signal {
  animation: cc-ping 1.8s ease-out infinite;
}

h2#board-title::before {
  content: "\1F4CB" / "";
}

h2#queue-title::before {
  content: "\1F5C2\FE0F" / "";
}

h2#usage-title::before {
  content: "\1F4CA" / "";
}

.running-now h3::before {
  content: "\1F680" / "";
}

.chart-heading h3::before {
  content: "\1FA99" / "";
}

.live-head h3::before {
  content: "\1F4E1" / "";
}

.drawer-bar h2::before {
  content: "\1F50E" / "";
}

.board-todo h3::before {
  content: "\1F4E5" / "";
}

.board-doing h3::before {
  content: "\1F6E0\FE0F" / "";
}

.board-review h3::before {
  content: "\1F50D" / "";
}

.board-approve h3::before {
  content: "\1F64B" / "";
}

.board-done h3::before {
  content: "\1F3C1" / "";
}

.board-problem h3::before {
  content: "\1F6A8" / "";
}

.chip-todo::before {
  content: "\1F4E5" / "";
}

.chip-doing::before {
  content: "\1F6E0\FE0F";
}

.chip-review::before {
  content: "\1F50D";
}

.chip-approve::before {
  content: "\1F64B";
}

.chip-done::before {
  content: "\1F3C1";
}

.chip-problem::before {
  content: "\1F6A8";
}

.overview-item:nth-child(1) span::before {
  content: "\1F4C1" / "";
}

.overview-item:nth-child(2) span::before {
  content: "\1F9E9" / "";
}

.overview-item:nth-child(3) span::before {
  content: "\1F4EC" / "";
}

.overview-item:nth-child(4) span::before {
  content: "\26A1" / "";
}

#tab-monitor::before {
  content: "\1F4E1" / "";
}

#tab-usage::before {
  content: "\1F4C8";
}

#refresh::before {
  content: "\1F504" / "";
}

#refresh:active::before {
  animation: cc-spin .6s linear;
}

.service-running #scheduler-state::before {
  content: "\1F7E2";
  margin-right: 7px;
  animation: cc-pulse 1.6s ease-in-out infinite;
}

.service-stopped #scheduler-state::before {
  content: "\1F534";
  margin-right: 7px;
}

#health::before {
  content: "\1F4F6";
  margin-right: 7px;
}

.run-row::after {
  content: "";
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--accent);
  animation: cc-ping 1.6s ease-out infinite;
  order: -1;
}

.view-section h3::before {
  content: "\1F4C4" / "";
}

.task-reason::before {
  content: "\1F4AC ";
}

.board-ai::before {
  content: "\1F916 ";
}

.provider-brand::before {
  content: "\2728";
  margin-right: 6px;
}

.badge.available::before {
  content: "\25CF ";
}

.badge.unavailable::before {
  content: "\25CB ";
}

.token-caption::before {
  content: "\1F4CA";
}

.quota-line::before {
  content: "\23F1\FE0F";
  margin-right: 6px;
}

.live-stamp::before {
  content: "";
  display: inline-block;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #6bc6aa;
  margin-right: 7px;
  animation: cc-ping 1.6s ease-out infinite;
}

.live-now {
  border-left: 3px solid #e6b45a;
  padding-left: 12px;
}

.live-now::before {
  content: "\1F4AD ";
}

#detail-panel summary::before {
  content: "\1F9FE" / "";
}

.log-file summary::before {
  content: "\1F4DC" / "";
}

.live-logs h4::before {
  content: "\1F4BB ";
}

.drawer-bar button::before {
  content: "\2715 " / "";
}

/* motion */
.board-card, .provider-card, .overview, .activity-panel, .board-column, .running-now, .service-panel {
  animation: cc-fade-up .35s ease-out both;
}

.board-card, .provider-card, .chip, .board-column, .overview-item, tr, button, .tab, .step, .run-row {
  transition: transform .18s ease,box-shadow .18s ease,background .18s ease,border-color .18s ease;
}

.board-card:hover, .provider-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 20px rgba(0,0,0,.35);
  border-color: #3f536f;
}

.chip:hover {
  transform: translateY(-1px);
  background: #1d2a3b;
}

tbody tr:hover {
  background: #17212e;
}

button:hover {
  transform: translateY(-1px);
  box-shadow: 0 3px 10px rgba(0,0,0,.3);
}

button:active {
  transform: translateY(0) scale(.97);
}

.tab:hover {
  transform: none;
  box-shadow: none;
}

.overview-item:hover strong {
  color: #6bc6aa;
}

.drawer:not([hidden]) {
  animation: cc-slide-in .25s ease-out;
}

.drawer-backdrop:not([hidden]) {
  animation: cc-fade-up .25s ease-out;
}

.bar-stack {
  transition: filter .15s,transform .15s;
}

.chart-column:hover .bar-stack {
  filter: brightness(1.25);
  transform: scaleX(1.12);
}

.quota-fill {
  background-image: linear-gradient(90deg,transparent,rgba(255,255,255,.22),transparent);
  background-size: 200% 100%;
  animation: cc-shimmer 2.6s linear infinite;
}

.step-current {
  animation: cc-glow 1.8s ease-in-out infinite;
}

@media (prefers-reduced-motion:reduce) {
  *, *::before, *::after {
    animation: none!important;
    transition: none!important;
  }
}

.board-activity {
  font-family: ui-monospace,Consolas,monospace;
  font-size: 10px;
  color: #9fdcc2;
  background: #0c131c;
  border: 1px solid var(--line);
  border-radius: 6px;
  padding: 5px 7px;
  overflow-wrap: anywhere;
  max-height: 3.6em;
  overflow: hidden;
}

.board-activity::before {
  content: "\25B6\FE0F" / "";
  margin-right: 5px;
  font-size: 9px;
}

/* Per-provider slot usage under the running-now heading */
.cap-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 10px;
}

.cap-chip {
  padding: 3px 11px;
  border-radius: 999px;
  border: 1px solid var(--accent);
  color: var(--accent);
  font-size: 11px;
  font-variant-numeric: tabular-nums;
}

.cap-chip.cap-full {
  background: rgba(230, 180, 90, 0.16);
  color: #f6d99a;
  border-color: #e6b45a;
}

.cap-chip.cap-off {
  opacity: 0.45;
  text-decoration: line-through;
}
