// Zero-dependency usage proxy. Run: node server.js  ->  http://localhost:3939
// Keys live in .env (never sent to the browser).
const http = require('http');
const fs = require('fs');
const path = require('path');
const { execFile } = require('child_process');

// --- tiny .env loader ---
try {
  for (const line of fs.readFileSync(path.join(__dirname, '.env'), 'utf8').split(/\r?\n/)) {
    const m = line.match(/^\s*([A-Z0-9_]+)\s*=\s*(.*?)\s*$/);
    if (m && !line.trim().startsWith('#') && m[2]) process.env[m[1]] ??= m[2].replace(/^["']|["']$/g, '');
  }
} catch {}

const PORT = +process.env.PORT || 3939;
const DAY = 864e5;
const DAYS = 7;
const dayKey = d => new Date(d).toISOString().slice(0, 10);

function emptyDays() {
  const days = [];
  const today = new Date(); today.setUTCHours(0, 0, 0, 0);
  for (let i = DAYS - 1; i >= 0; i--) days.push({ date: dayKey(today - i * DAY), tokens: 0, requests: 0, cost: 0 });
  return days;
}
const bucketDay = (days, iso) => days.find(d => d.date === dayKey(iso));

async function getJson(url, headers) {
  const r = await fetch(url, { headers });
  const text = await r.text();
  if (!r.ok) throw new Error(`${r.status} ${text.slice(0, 200)}`);
  return JSON.parse(text);
}

// ---------- Anthropic (Admin API key: sk-ant-admin...) ----------
async function claude() {
  const key = process.env.ANTHROPIC_ADMIN_KEY;
  if (!key) return { ok: false, error: 'ยังไม่ได้ตั้ง ANTHROPIC_ADMIN_KEY' };
  const h = { 'x-api-key': key, 'anthropic-version': '2023-06-01' };
  const start = new Date(Date.now() - (DAYS - 1) * DAY); start.setUTCHours(0, 0, 0, 0);
  const q = `starting_at=${start.toISOString()}&ending_at=${new Date().toISOString()}&bucket_width=1d&limit=${DAYS}`;
  const days = emptyDays();
  const [usage, cost] = await Promise.all([
    getJson(`https://api.anthropic.com/v1/organizations/usage_report/messages?${q}`, h),
    getJson(`https://api.anthropic.com/v1/organizations/cost_report?${q}`, h).catch(() => null),
  ]);
  for (const b of usage.data || []) {
    const d = bucketDay(days, b.starting_at); if (!d) continue;
    for (const r of b.results || []) {
      const cc = r.cache_creation || {};
      d.tokens += (r.uncached_input_tokens || 0) + (r.cache_read_input_tokens || 0) +
        Object.values(cc).reduce((a, n) => a + (+n || 0), 0) + (r.output_tokens || 0);
    }
  }
  for (const b of (cost && cost.data) || []) {
    const d = bucketDay(days, b.starting_at); if (!d) continue;
    // amount is a decimal string in cents
    for (const r of b.results || []) d.cost += (parseFloat(r.amount) || 0) / 100;
  }
  return { ok: true, days, hasRequests: false };
}

// ---------- OpenAI (Admin key: sk-admin-...) ----------
async function chatgpt() {
  const key = process.env.OPENAI_ADMIN_KEY;
  if (!key) return { ok: false, error: 'ยังไม่ได้ตั้ง OPENAI_ADMIN_KEY' };
  const h = { Authorization: `Bearer ${key}` };
  const start = Math.floor((Date.now() - (DAYS - 1) * DAY) / 1000);
  const q = `start_time=${start}&bucket_width=1d&limit=${DAYS}`;
  const days = emptyDays();
  const [usage, cost] = await Promise.all([
    getJson(`https://api.openai.com/v1/organization/usage/completions?${q}`, h),
    getJson(`https://api.openai.com/v1/organization/costs?${q}`, h).catch(() => null),
  ]);
  for (const b of usage.data || []) {
    const d = bucketDay(days, b.start_time * 1000); if (!d) continue;
    for (const r of b.results || []) {
      d.tokens += (r.input_tokens || 0) + (r.output_tokens || 0);
      d.requests += r.num_model_requests || 0;
    }
  }
  for (const b of (cost && cost.data) || []) {
    const d = bucketDay(days, b.start_time * 1000); if (!d) continue;
    for (const r of b.results || []) d.cost += (r.amount && +r.amount.value) || 0;
  }
  return { ok: true, days, hasRequests: true };
}

// ---------- Gemini (Cloud Monitoring request_count; needs a GCP project) ----------
function gcloudToken() {
  return new Promise((res, rej) =>
    execFile('gcloud', ['auth', 'print-access-token'], { shell: true }, (e, out) => e ? rej(e) : res(out.trim())));
}
async function gemini() {
  const project = process.env.GCP_PROJECT_ID;
  if (!project) return { ok: false, error: 'ยังไม่ได้ตั้ง GCP_PROJECT_ID (Gemini ต้องดูผ่าน Google Cloud)' };
  let token = process.env.GCP_ACCESS_TOKEN;
  if (!token) {
    try { token = await gcloudToken(); }
    catch { return { ok: false, error: 'ไม่มี GCP_ACCESS_TOKEN และรัน gcloud ไม่ได้' }; }
  }
  const start = new Date(Date.now() - (DAYS - 1) * DAY); start.setUTCHours(0, 0, 0, 0);
  const params = new URLSearchParams({
    filter: 'metric.type="serviceruntime.googleapis.com/api/request_count" AND resource.labels.service="generativelanguage.googleapis.com"',
    'interval.startTime': start.toISOString(),
    'interval.endTime': new Date().toISOString(),
    'aggregation.alignmentPeriod': '86400s',
    'aggregation.perSeriesAligner': 'ALIGN_SUM',
    'aggregation.crossSeriesReducer': 'REDUCE_SUM',
  });
  const j = await getJson(`https://monitoring.googleapis.com/v3/projects/${project}/timeSeries?${params}`,
    { Authorization: `Bearer ${token}` });
  const days = emptyDays();
  for (const ts of j.timeSeries || []) for (const p of ts.points || []) {
    // alignment periods are anchored to the interval start, so the end time falls on the day
    const d = bucketDay(days, p.interval.startTime);
    if (d) d.requests += +(p.value.int64Value || 0);
  }
  return { ok: true, days, hasRequests: true, noTokens: true };
}

// ---------- Local CLI logs (no keys needed) ----------
const os = require('os');
const HOME = os.homedir();
const H5 = 5 * 3600e3, WEEK = 7 * DAY;

function walk(dir, test, out = [], minMtime = 0) {
  let ents = [];
  try { ents = fs.readdirSync(dir, { withFileTypes: true }); } catch { return out; }
  for (const e of ents) {
    const f = path.join(dir, e.name);
    if (e.isDirectory()) walk(f, test, out, minMtime);
    else if (test(e.name)) { try { if (fs.statSync(f).mtimeMs >= minMtime) out.push(f); } catch {} }
  }
  return out;
}
const sinceMs = () => { const d = new Date(Date.now() - (DAYS - 1) * DAY); d.setUTCHours(0, 0, 0, 0); return d.getTime(); };

// per-file parse cache: only re-read a log when its size/mtime changed (keeps realtime polling cheap)
const fileCache = new Map();
function parsed(f, parse) {
  const st = fs.statSync(f), key = `${st.mtimeMs}:${st.size}`, c = fileCache.get(f);
  if (c && c.key === key) return c.val;
  const val = parse(fs.readFileSync(f, 'utf8'));
  fileCache.set(f, { key, val });
  return val;
}

function claudeEvents() {
  const ev = [], seen = new Set(), from = sinceMs();
  for (const f of walk(path.join(HOME, '.claude', 'projects'), n => n.endsWith('.jsonl'), [], from)) {
    for (const x of parsed(f, txt => {
      const r = [];
      for (const line of txt.split('\n')) {
        if (!line.includes('"usage"')) continue;
        let o; try { o = JSON.parse(line); } catch { continue; }
        const u = o.message && o.message.usage; if (!u || !o.timestamp) continue;
        r.push({ id: (o.message.id || '') + (o.requestId || ''), t: Date.parse(o.timestamp),
          n: (u.input_tokens || 0) + (u.cache_creation_input_tokens || 0) + (u.output_tokens || 0) });
      }
      return r;
    })) {
      if (x.id) { if (seen.has(x.id)) continue; seen.add(x.id); }
      if (x.t >= from) ev.push(x);
    }
  }
  return { events: ev, source: 'Claude Code (log ในเครื่อง)' };
}

function codexEvents() {
  const ev = [], from = sinceMs();
  let rate = null, rateT = 0;
  for (const f of walk(path.join(HOME, '.codex', 'sessions'), n => n.startsWith('rollout-'), [], from)) {
    for (const x of parsed(f, txt => {
      const r = [];
      for (const line of txt.split('\n')) {
        if (!line.includes('token_count')) continue;
        let o; try { o = JSON.parse(line); } catch { continue; }
        const p = o.payload; if (!p || p.type !== 'token_count') continue;
        const u = p.info && p.info.last_token_usage;
        r.push({ t: Date.parse(o.timestamp), n: u ? (u.input_tokens || 0) + (u.output_tokens || 0) : 0, rate: p.rate_limits });
      }
      return r;
    })) {
      if (x.rate && x.t > rateT) { rateT = x.t; rate = x.rate; }
      if (x.n && x.t >= from) ev.push({ t: x.t, n: x.n });
    }
  }
  const limits = rate ? [rate.primary, rate.secondary].filter(Boolean).map(w => ({
    label: w.window_minutes >= 1440 ? `โควต้า ${Math.round(w.window_minutes / 1440)} วัน` : `โควต้า ${Math.round(w.window_minutes / 60)} ชม.`,
    pct: w.used_percent, resetsAt: w.resets_at * 1000 })) : [];
  return { events: ev, source: `Codex CLI (log ในเครื่อง${rate ? ', แพ็กเกจ ' + rate.plan_type : ''})`, realLimits: limits };
}

function geminiEvents() {
  const ev = [], from = sinceMs();
  for (const f of walk(path.join(HOME, '.gemini'), n => n.endsWith('.pbtxt'), [], from).filter(f => /annotations/.test(f)))
    ev.push({ t: fs.statSync(f).mtimeMs, n: 1 });
  return { events: ev, source: 'Gemini/Antigravity (นับเซสชันจากไฟล์ในเครื่อง ไม่มี token)', unit: 'sessions', noTokens: true };
}

// ---------- config (user-set 5h / weekly limits) ----------
const CFG = path.join(__dirname, 'config.json');
const loadCfg = () => { try { return JSON.parse(fs.readFileSync(CFG, 'utf8')); } catch { return {}; } };

function windowStat(events, ms, limit) {
  const since = Date.now() - ms;
  const inWin = events.filter(e => e.t > since);
  const used = inWin.reduce((a, e) => a + e.n, 0);
  const oldest = inWin.length ? Math.min(...inWin.map(e => e.t)) : null;
  return { used, limit: limit || null, remaining: limit ? Math.max(0, limit - used) : null,
    pct: limit ? Math.min(100, used / limit * 100) : null, resetsAt: oldest ? oldest + ms : null };
}

function fromLocal(k, loc) {
  const days = emptyDays(), cfg = loadCfg()[k] || {};
  for (const e of loc.events) {
    const d = bucketDay(days, e.t);
    if (d) { if (loc.noTokens) d.requests += e.n; else { d.tokens += e.n; d.requests += 1; } }
  }
  return { ok: true, source: loc.source, days, hasRequests: true, noTokens: !!loc.noTokens, unit: loc.unit,
    windows: [{ label: '5 ชม.', key: 'h5', ...windowStat(loc.events, H5, cfg.h5) },
              { label: 'สัปดาห์', key: 'week', ...windowStat(loc.events, WEEK, cfg.week) }],
    realLimits: loc.realLimits || [] };
}

// API result (cached 60s so realtime polling doesn't hammer the vendors), else local logs
const apiCache = {};
const withLocal = (k, api, loc) => async () => {
  const c = apiCache[k];
  let r = c && Date.now() - c.t < 60e3 ? c.r : null;
  if (!r) { r = await api().catch(e => ({ ok: false, error: String(e.message || e) })); apiCache[k] = { t: Date.now(), r }; }
  if (r.ok) return r;
  try { return fromLocal(k, loc()); } catch { return r; }
};
// Real 5h / weekly % for the Claude subscription, using Claude Code's own login (read-only, token never leaves this machine
// except in the request to api.anthropic.com). Undocumented endpoint: if it fails we silently fall back to the manual limits.
// Plan-limit endpoints rate-limit aggressive polling (Claude's returns 429). Poll rarely, keep the last good value
// for up to 30 min so the card doesn't flip back to log-only, and back off after a failure.
const OK_EVERY = 5 * 60e3, FAIL_BACKOFF = 5 * 60e3, STALE_MAX = 0;
const keep = (c, v) => v ? { t: Date.now(), next: Date.now() + OK_EVERY, v, ok: Date.now() }
  : { t: Date.now(), next: Date.now() + FAIL_BACKOFF, v: c.v && Date.now() - c.ok < STALE_MAX ? c.v : null, ok: c.ok };
let oauthCache = { next: 0, v: null };
const CRED = path.join(HOME, '.claude', '.credentials.json');
// Refresh an expired Claude login. Re-reads the file first (Claude Code may have refreshed it already), and writes it back
// atomically with every other field untouched. One refresh at a time. Uses Claude Code's public OAuth client id.
let refreshing = null;
function refreshClaudeToken() {
  return refreshing ??= (async () => {
    try {
      const c = JSON.parse(fs.readFileSync(CRED, 'utf8')), o = c.claudeAiOauth;
      if (o.expiresAt > Date.now() + 60e3) return true; // someone else already refreshed
      const r = await fetch('https://console.anthropic.com/v1/oauth/token', { method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ grant_type: 'refresh_token', refresh_token: o.refreshToken, client_id: '9d1c250a-e61b-44d9-88ed-5944d1962f5e' }) });
      if (!r.ok) throw new Error('refresh ' + r.status);
      const j = await r.json();
      o.accessToken = j.access_token;
      if (j.refresh_token) o.refreshToken = j.refresh_token;
      o.expiresAt = Date.now() + j.expires_in * 1000;
      if (j.refresh_token_expires_in) o.refreshTokenExpiresAt = Date.now() + j.refresh_token_expires_in * 1000;
      fs.writeFileSync(CRED + '.tmp', JSON.stringify(c)); fs.renameSync(CRED + '.tmp', CRED);
      console.log('claude login refreshed, valid for', Math.round(j.expires_in / 3600), 'h');
      return true;
    } catch (e) { console.log('claude token refresh failed:', e.message.slice(0, 80)); return false; }
    finally { refreshing = null; }
  })();
}
async function claudePlanLimits() {
  if (Date.now() < oauthCache.next) return oauthCache.v;
  let v = null;
  try {
    let o = JSON.parse(fs.readFileSync(CRED, 'utf8')).claudeAiOauth;
    if (o && o.expiresAt && o.expiresAt < Date.now() + 60e3 && await refreshClaudeToken()) o = JSON.parse(fs.readFileSync(CRED, 'utf8')).claudeAiOauth;
    if (o && o.accessToken && (!o.expiresAt || o.expiresAt > Date.now())) {
      const j = await getJson('https://api.anthropic.com/api/oauth/usage',
        { Authorization: `Bearer ${o.accessToken}`, 'anthropic-beta': 'oauth-2025-04-20' });
      v = [['5 ชม.', j.five_hour], ['สัปดาห์', j.seven_day]].filter(([, w]) => w && w.utilization != null)
        .map(([label, w]) => ({ label, pct: w.utilization, resetsAt: Date.parse(w.resets_at) }));
      if (!v.length) v = null;
      if (v) v.plan = o.subscriptionType;
    }
  } catch (e) { console.log('claude plan limits:', e.message.slice(0, 80)); }
  oauthCache = keep(oauthCache, v);
  return v;
}
// Preferred source: Claude Code's statusline hook (~/.claude/usage-monitor-statusline.js) writes the plan rate limits to a file
// whenever a Claude Code session updates. No network call, so no rate limiting. A window whose reset time has passed is dropped.
function claudeStatuslineLimits() {
  try {
    const f = path.join(HOME, '.claude', 'usage-monitor-rate-limits.json');
    const { updatedAt, rate_limits: rl } = JSON.parse(fs.readFileSync(f, 'utf8'));
    const ago = Math.max(0, Math.round((Date.now() - updatedAt) / 60000));
    const out = [];
    for (const [label, w] of [['5 ชม.', rl.five_hour], ['สัปดาห์', rl.seven_day]]) {
      if (!w) continue;
      const pct = w.used_percentage ?? w.utilization; if (pct == null) continue;
      let r = w.resets_at; r = typeof r === 'string' ? Date.parse(r) : (r < 1e12 ? r * 1000 : r);
      if (!(r > Date.now())) continue;
      out.push({ label: ago >= 2 ? `${label} (อัปเดต ${ago} น.ที่แล้ว)` : label, pct, resetsAt: r });
    }
    if (!out.length) return null;
    out.plan = 'statusline';
    return out;
  } catch { return null; }
}
const claudeProvider = withLocal('claude', claude, claudeEvents);
const claudeWithPlan = async () => {
  const r = await claudeProvider();
  const lim = r.ok && (claudeStatuslineLimits() || await claudePlanLimits());
  if (!lim) return r;
  return { ...r, windows: [], realLimits: lim, source: `${r.source} + โควต้าจริงจากบัญชี (${lim.plan})` };
};
// Real 5h / weekly % for ChatGPT (same numbers as Settings > Usage) using Codex CLI's login. Undocumented endpoint; falls back silently.
let gptCache = { next: 0, v: null };
async function chatgptPlanLimits() {
  if (Date.now() < gptCache.next) return gptCache.v;
  let v = null;
  try {
    const t = JSON.parse(fs.readFileSync(path.join(HOME, '.codex', 'auth.json'), 'utf8')).tokens;
    if (t && t.access_token) {
      const j = await getJson('https://chatgpt.com/backend-api/wham/usage',
        { Authorization: `Bearer ${t.access_token}`, 'ChatGPT-Account-Id': t.account_id, 'User-Agent': 'codex-cli' });
      const rl = j.rate_limit || {};
      v = [['5 ชม.', rl.primary_window], ['สัปดาห์', rl.secondary_window]].filter(([, w]) => w && w.used_percent != null)
        .map(([label, w]) => ({ label, pct: w.used_percent, resetsAt: w.reset_at * 1000 }));
      if (!v.length) v = null; else v.plan = j.plan_type;
    }
  } catch (e) { console.log('chatgpt plan limits:', e.message.slice(0, 80)); }
  gptCache = keep(gptCache, v);
  return v;
}
const gptProvider = withLocal('chatgpt', chatgpt, codexEvents);
const gptWithPlan = async () => {
  const r = await gptProvider();
  const lim = r.ok && await chatgptPlanLimits();
  if (!lim) return r;
  return { ...r, windows: [], realLimits: lim, source: `Codex CLI (log ในเครื่อง) + โควต้าจริงจากบัญชี (${lim.plan})` };
};
// Gemini / Antigravity: ask the local language_server (what the Antigravity app itself uses) for per-model quota.
// It exposes the 5h window per model group only; no weekly figure, so weekly stays a manual limit.
let agCache = { t: 0, v: null }, agConn = null;
function agDiscover() {
  const ps = c => require('child_process').execFileSync('powershell', ['-NoProfile', '-Command', c], { encoding: 'utf8', timeout: 8000 }).trim();
  const raw = ps("Get-CimInstance Win32_Process -Filter \"Name='language_server.exe'\" | Select ProcessId,CommandLine | ConvertTo-Json -Compress");
  if (!raw) return null;
  for (const p of [].concat(JSON.parse(raw))) {
    const m = /--csrf_token\s+(\S+)/.exec(p.CommandLine || ''); if (!m) continue;
    const ports = ps(`(Get-NetTCPConnection -State Listen -OwningProcess ${p.ProcessId}).LocalPort -join ','`).split(',').map(Number);
    return { csrf: m[1], ports };
  }
  return null;
}
function agCall(port, csrf, method) {
  return new Promise((res, rej) => {
    const req = require('https').request({ host: '127.0.0.1', port, method: 'POST', rejectUnauthorized: false, timeout: 4000,
      path: '/exa.language_server_pb.LanguageServerService/' + method,
      headers: { 'Content-Type': 'application/json', 'Connect-Protocol-Version': '1', 'x-codeium-csrf-token': csrf } },
      r => { let b = ''; r.on('data', d => b += d); r.on('end', () => r.statusCode === 200 ? res(JSON.parse(b)) : rej(new Error('status ' + r.statusCode))); });
    req.on('error', rej); req.on('timeout', () => { req.destroy(); rej(new Error('timeout')); });
    req.end('{}');
  });
}
async function geminiPlanLimits() {
  if (Date.now() - agCache.t < 30e3) return agCache.v;
  let v = null;
  for (let attempt = 0; attempt < 2 && !v; attempt++) {
    try {
      if (!agConn || attempt) agConn = agDiscover();
      if (!agConn) break;
      let j = null;
      for (const port of agConn.ports) { try { j = await agCall(port, agConn.csrf, 'RetrieveUserQuotaSummary'); break; } catch {} }
      if (!j) { agConn = null; continue; }
      const out = [];
      for (const g of j.response.groups || []) {
        const name = /gemini/i.test(g.displayName) ? 'Gemini' : 'Claude / GPT-OSS';
        for (const [win, label] of [['5h', '5 ชม.'], ['weekly', 'สัปดาห์']]) {
          const bk = (g.buckets || []).find(x => x.window === win); if (!bk) continue;
          out.push({ label: label + ' · ' + name, pct: (1 - bk.remainingFraction) * 100, resetsAt: Date.parse(bk.resetTime) });
        }
      }
      v = out.length ? out : null;
    } catch { agConn = null; }
  }
  agCache = { t: Date.now(), v };
  return v;
}
const geminiProvider = withLocal('gemini', gemini, geminiEvents);
const geminiWithPlan = async () => {
  const r = await geminiProvider();
  const lim = r.ok && await geminiPlanLimits();
  if (!lim) return r;
  return { ...r, windows: [], realLimits: lim, source: 'Antigravity (โควต้า 5 ชม. และรายสัปดาห์จริงจากแอป)' };
};
const providers = {
  claude: claudeWithPlan,
  chatgpt: gptWithPlan,
  gemini: geminiWithPlan,
};

async function usage() {
  const out = {};
  await Promise.all(Object.entries(providers).map(async ([k, fn]) => {
    try { out[k] = await fn(); } catch (e) { out[k] = { ok: false, error: String(e.message || e) }; }
  }));
  return { updated: new Date().toISOString(), ...out };
}

// ---------- realtime: poll cheaply, push over SSE only when something changed ----------
const clients = new Set();
let lastHash = '';
async function tick() {
  if (!clients.size) return;
  const data = await usage();
  const { updated, ...rest } = data;
  const h = JSON.stringify(rest);
  if (h === lastHash) return;
  lastHash = h;
  for (const c of clients) c.write(`data: ${JSON.stringify(data)}\n\n`);
}
setInterval(() => tick().catch(() => {}), 3000);

const CORS = { 'Access-Control-Allow-Origin': '*', 'Access-Control-Allow-Headers': '*' };
http.createServer(async (req, res) => {
  if (req.method === 'OPTIONS') { res.writeHead(204, CORS).end(); return; }
  if (req.url.startsWith('/api/stream')) {
    res.writeHead(200, { ...CORS, 'Content-Type': 'text/event-stream', 'Cache-Control': 'no-cache' });
    clients.add(res); req.on('close', () => clients.delete(res));
    res.write(`data: ${JSON.stringify(await usage())}\n\n`);
    return;
  }
  if (req.method === 'POST' && req.url === '/api/config') {
    let body = ''; for await (const ch of req) body += ch;
    try {
      const { provider, window: w, limit } = JSON.parse(body);
      if (!providers[provider] || !['h5', 'week'].includes(w)) throw new Error('bad');
      const cfg = loadCfg(); cfg[provider] = { ...cfg[provider], [w]: +limit > 0 ? +limit : undefined };
      fs.writeFileSync(CFG, JSON.stringify(cfg, null, 2)); lastHash = '';
      res.writeHead(200, CORS).end('ok');
    } catch { res.writeHead(400, CORS).end(); }
    return;
  }
  if (req.url.startsWith('/api/usage')) {
    res.writeHead(200, { ...CORS, 'Content-Type': 'application/json' });
    return res.end(JSON.stringify(await usage()));
  }
  if (req.url === '/' || req.url === '/index.html') {
    res.writeHead(200, { 'Content-Type': 'text/html; charset=utf-8' });
    return res.end(fs.readFileSync(path.join(__dirname, 'index.html')));
  }
  res.writeHead(404).end();
}).listen(PORT, '127.0.0.1', () => console.log(`AI usage monitor: http://localhost:${PORT}`));
