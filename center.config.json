  "skills": {
    "systematic-debugging": {
      "roles": [
        "implementation"
      ],
      "kinds": [
        "bugfix"
      ],
      "instruction": "Reproduce the failure first, form one hypothesis at a time, find the root cause before changing code, add a regression test, then make the smallest fix. Do not patch symptoms."
    },
    "test-driven-development": {
      "roles": [
        "implementation"
      ],
      "kinds": [
        "feature",
        "test"
      ],
      "instruction": "Write or extend a failing test for each acceptance criterion first, then the minimal code to pass it, then tidy. Keep changes inside the task scope and keep existing tests green."
    },
    "safe-refactoring": {
      "roles": [
        "implementation"
      ],
      "kinds": [
        "refactor"
      ],
      "instruction": "Preserve behavior exactly. Make small mechanical steps, keep tests passing after each, avoid unrelated edits and public API changes unless the task requires them."
    },
    "concise-documentation": {
      "roles": [
        "implementation"
      ],
      "kinds": [
        "docs"
      ],
      "instruction": "Document only what the code really does, verified against the source. Prefer short examples that run, no speculation, no marketing language."
    },
    "security-hardening": {
      "roles": [
        "implementation",
        "review"
      ],
      "kinds": [
        "security"
      ],
      "instruction": "Treat all input as untrusted. Check authentication, authorization, injection, secret handling and error leakage. Never log or return credentials. Prefer deny-by-default."
    },
    "independent-code-review": {
      "roles": [
        "review"
      ],
      "kinds": [
        "any"
      ],
      "instruction": "Review the full scoped patch and new files against every acceptance criterion. Look for correctness bugs, missing edge cases, scope creep and missing tests. Do not edit files. Reject with concrete reasons when criteria are unmet; approve only when you verified them."
    }
  },
  "auto_retry": true,
  "auto_failover": true,
  "queue_stall_seconds": 1800,
  "ide_reserved_sessions": 1,
  "quota_floor": {
