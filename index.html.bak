<!doctype html>
<html lang="th">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>AI Usage Monitor</title>
<style>
:root{--bg:#f6f5f2;--card:#fff;--text:#1d1d1b;--muted:#77756f;--line:#e6e3dc;--warn:#e0a100;--danger:#d93f3f;--claude:#d97757;--chatgpt:#10a37f;--gemini:#4a7dff}
@media (prefers-color-scheme: dark){:root{--bg:#161615;--card:#212120;--text:#f1efe9;--muted:#9a978f;--line:#33322f}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font:15px/1.5 system-ui,-apple-system,"Segoe UI",sans-serif}
main{max-width:980px;margin:0 auto;padding:24px 16px 48px}
header{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px;gap:8px;flex-wrap:wrap}
h1{font-size:20px;margin:0}
.sub{color:var(--muted);font-size:13px}
.live{display:inline-block;width:8px;height:8px;border-radius:50%;background:#aaa;margin-right:6px}
.live.on{background:#2fb344;animation:p 2s infinite}
@keyframes p{50%{opacity:.35}}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:14px}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px}
.name{display:flex;align-items:center;gap:8px;font-weight:600}
.dot{width:10px;height:10px;border-radius:50%;background:var(--c)}
.big{font-size:30px;font-weight:700;margin-top:8px;font-variant-numeric:tabular-nums}
.big small{font-size:13px;color:var(--muted);font-weight:400}
.win{margin-top:14px}
.wh{display:flex;justify-content:space-between;font-size:13px}
.wh span:first-child{font-weight:600}
.bar{height:8px;background:var(--line);border-radius:99px;overflow:hidden;margin:5px 0}
.bar i{display:block;height:100%;background:var(--c);border-radius:99px;transition:width .4s}
.bar i.warn{background:var(--warn)}.bar i.danger{background:var(--danger)}
.wf{display:flex;justify-content:space-between;color:var(--muted);font-size:12px}
.wf a{color:var(--c);cursor:pointer;text-decoration:underline}
.row{display:flex;justify-content:space-between;color:var(--muted);font-size:13px;margin-top:4px}
.row b{color:var(--text);font-weight:600}
.hist{display:flex;align-items:flex-end;gap:5px;height:48px;margin-top:16px}
.hist div{flex:1;background:var(--c);opacity:.35;border-radius:3px 3px 0 0;min-height:2px}
.hist div:last-child{opacity:1}
.hl{display:flex;gap:5px;color:var(--muted);font-size:10px;margin-top:3px}
.hl span{flex:1;text-align:center}
.err{margin-top:12px;color:var(--muted);font-size:12px;word-break:break-word}
.note{margin-top:20px;color:var(--muted);font-size:12px}
</style>
</head>
<body>
<main>
  <header>
    <h1>AI Usage Monitor</h1>
    <span class="sub"><span class="live" id="live"></span><span id="upd">กำลังเชื่อมต่อ…</span></span>
  </header>
  <div class="grid" id="grid"></div>
  <p class="note">อัปเดตแบบ realtime · "จากแพ็กเกจจริง" คือค่าจากบัญชีโดยตรง ส่วนช่องที่ไม่มีค่านี้จะนับจาก log ในเครื่องและต้องกด "ตั้ง limit" เอง · วันที่ในกราฟเป็น UTC</p>
</main>
<script>
const BASE = location.protocol === 'file:' ? 'http://localhost:3939' : '';
const META = {
  claude:  { label: 'Claude',  color: 'var(--claude)' },
  chatgpt: { label: 'ChatGPT', color: 'var(--chatgpt)' },
  gemini:  { label: 'Gemini',  color: 'var(--gemini)' },
};
const fmt = n => n >= 1e6 ? (n / 1e6).toFixed(1) + 'M' : n >= 1e3 ? (n / 1e3).toFixed(1) + 'k' : String(Math.round(n));
const sum = (days, f) => days.reduce((a, d) => a + d[f], 0);
const cls = pct => pct >= 90 ? 'danger' : pct >= 70 ? 'warn' : '';
let data = null;

function dur(ms) {
  if (!ms || ms <= 0) return '—';
  const m = Math.ceil(ms / 60000), h = Math.floor(m / 60);
  if (h >= 24) return Math.floor(h / 24) + ' วัน ' + (h % 24) + ' ชม.';
  return h ? `${h} ชม. ${m % 60} น.` : `${m} น.`;
}

function bar(pct) { return `<div class="bar"><i class="${cls(pct)}" style="width:${pct}%"></i></div>`; }

function winHtml(k, w, noTokens) {
  const u = noTokens ? 'เซสชัน' : 'tokens';
  const reset = w.resetsAt ? `รีเซ็ตใน ${dur(w.resetsAt - Date.now())}` : 'ยังไม่ได้ใช้';
  if (!w.limit) return `<div class="win"><div class="wh"><span>${w.label}</span><span>ใช้ไป ${fmt(w.used)} ${u}</span></div>${bar(0)}
    <div class="wf"><span>${reset}</span><a data-set="${k}:${w.key}">ตั้ง limit เพื่อดูที่เหลือ</a></div></div>`;
  return `<div class="win"><div class="wh"><span>${w.label}</span><span>เหลือ ${(100 - w.pct).toFixed(0)}%</span></div>${bar(w.pct)}
    <div class="wf"><span>ใช้ไป ${w.pct.toFixed(0)}% (${fmt(w.used)} / ${fmt(w.limit)}) · ${reset}</span><a data-set="${k}:${w.key}">แก้ limit</a></div></div>`;
}

function realHtml(l) {
  const left = Math.max(0, 100 - l.pct);
  return `<div class="win"><div class="wh"><span>${l.label} (จากแพ็กเกจจริง)</span><span>เหลือ ${left.toFixed(0)}%</span></div>${bar(l.pct)}
    <div class="wf"><span>ใช้ไป ${l.pct.toFixed(0)}%</span><span>รีเซ็ตใน ${dur(l.resetsAt - Date.now())}</span></div></div>`;
}

function card(k, p) {
  const m = META[k];
  const head = `<div class="name"><span class="dot"></span>${m.label}</div>`;
  if (!p || !p.ok) return `<div class="card" style="--c:${m.color}">${head}<div class="err">${p ? p.error : 'กำลังโหลด…'}</div></div>`;
  const f = p.noTokens ? 'requests' : 'tokens';
  const today = p.days[p.days.length - 1];
  const max = Math.max(1, ...p.days.map(d => d[f]));
  const costRow = p.days.some(d => d.cost) ? `<div class="row"><span>ค่าใช้จ่าย 7 วัน</span><b>$${sum(p.days, 'cost').toFixed(2)}</b></div>` : '';
  return `<div class="card" style="--c:${m.color}">${head}
    ${(p.realLimits || [])[0]
      ? `<div class="big">${(100 - p.realLimits[0].pct).toFixed(0)}% <small>เหลือ (${p.realLimits[0].label})</small></div>
         <div class="row"><span>วันนี้ใช้ไป</span><b>${fmt(today[f])} ${p.noTokens ? 'เซสชัน' : 'tokens'}</b></div>`
      : `<div class="big">${fmt(today[f])} <small>${p.noTokens ? 'เซสชัน' : 'tokens'} วันนี้</small></div>`}
    ${(p.windows || []).map(w => winHtml(k, w, p.noTokens)).join('')}
    ${(p.realLimits || []).map(realHtml).join('')}
    <div class="row"><span>7 วัน</span><b>${fmt(sum(p.days, f))}</b></div>${costRow}
    <div class="hist">${p.days.map(d => `<div title="${d.date}: ${fmt(d[f])}" style="height:${d[f] / max * 100}%"></div>`).join('')}</div>
    <div class="hl">${p.days.map(d => `<span>${d.date.slice(8)}</span>`).join('')}</div>
    ${p.source ? `<div class="err">แหล่งข้อมูล: ${p.source}</div>` : ''}</div>`;
}

function render() {
  if (!data) return;
  document.getElementById('grid').innerHTML = Object.keys(META).map(k => card(k, data[k])).join('');
  document.getElementById('upd').textContent = 'realtime · อัปเดต ' + new Date(data.updated).toLocaleTimeString('th-TH');
}

document.getElementById('grid').addEventListener('click', async e => {
  const a = e.target.closest('[data-set]'); if (!a) return;
  const [provider, window_] = a.dataset.set.split(':');
  const v = prompt(`ตั้ง limit ของ ${META[provider].label} (${window_ === 'h5' ? '5 ชม.' : 'สัปดาห์'}) เป็นหน่วย ${data[provider].noTokens ? 'เซสชัน' : 'tokens'} — เว้นว่างเพื่อลบ`);
  if (v === null) return;
  await fetch(BASE + '/api/config', { method: 'POST', body: JSON.stringify({ provider, window: window_, limit: v.replace(/[,_\s]/g, '') }) });
});

let es;
function connect() {
  es = new EventSource(BASE + '/api/stream');
  es.onopen = () => document.getElementById('live').classList.add('on');
  es.onmessage = ev => { data = JSON.parse(ev.data); render(); };
  es.onerror = () => { document.getElementById('live').classList.remove('on'); document.getElementById('upd').textContent = 'เชื่อมต่อ server ไม่ได้ — รัน node server.js'; };
}
connect();
setInterval(render, 30000); // keep countdowns ticking between pushes
</script>
</body>
</html>
